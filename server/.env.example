# Copy this file to ".env" (same folder) and fill in your values.
# The server loads it automatically on start.

# Admin panel password. Always set your own in production.
ADMIN_PASSWORD=saree-admin

# ---- Where sarees, stock, orders and photos are kept ------------------------
# Leave all three blank for local development: an embedded Postgres keeps
# everything in server/data/pgdata and photos go to server/data/uploads.
# Render's free plan erases its disk on every restart, deploy and wake-up, so
# set all three there (Supabase, free plan — see the README).
#   DATABASE_URL          Supabase → Connect → "Session pooler" string (works
#                         over IPv4, which Render needs). URL-encode any special
#                         characters in the password.
#   SUPABASE_URL          Supabase → Project Settings → API → Project URL
#   SUPABASE_SERVICE_KEY  Supabase → Project Settings → API Keys → a secret key
#                         (sb_secret_…) or the legacy service_role key. Server
#                         only — never put it in the storefront.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Razorpay (the gateway used when these are set) --------------------------
# Razorpay dashboard → Account & Settings → API Keys. Test keys start with
# rzp_test_ and take no real money; orders paid with them are marked TEST.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard → Settings → Webhooks. Add a webhook for payment.captured
# and payment.failed pointing at
# PUBLIC_SERVER_URL/api/payments/razorpay/webhook, and paste its secret here.
# It is what saves an order when a shopper pays and closes the tab.
RAZORPAY_WEBHOOK_SECRET=

# Force a gateway instead of picking automatically: razorpay, hdfc or demo.
PAYMENT_PROVIDER=

# true while testing with a bank's UAT keys, so every order is marked TEST and
# never shipped. Keys beginning rzp_test_ are detected on their own.
PAYMENT_TEST_MODE=

# ---- HDFC SmartGateway (used when Razorpay keys are absent) -------------------
# From the SmartGateway dashboard. Leave HDFC_API_KEY blank to run checkout in
# demo mode (no real charge). Paste the raw API key; the server Base64-encodes
# it for you.
HDFC_API_KEY=
HDFC_MERCHANT_ID=
# payment_page_client_id: "hdfcmaster" for sandbox; defaults to the merchant id.
HDFC_CLIENT_ID=
# "sandbox" (UAT) or "production". Sandbox orders are marked TEST — don't ship.
HDFC_ENV=production
# x-resellerid (leave as is unless the bank tells you otherwise)
HDFC_RESELLER_ID=hdfc_reseller
# The dashboard's Response Key. Used to check the signature on every payment
# return; the result is recorded in each order's payment log.
HDFC_RESPONSE_KEY=

# Public URLs. PUBLIC_SERVER_URL is this API's https address (HDFC sends
# shoppers back to PUBLIC_SERVER_URL/api/payments/hdfc/return/…); CLIENT_URL is
# the storefront. In production:
#   PUBLIC_SERVER_URL=https://api.shophaveliwale.com
#   CLIENT_URL=https://www.shophaveliwale.com
PUBLIC_SERVER_URL=http://localhost:5050
CLIENT_URL=http://localhost:5173
# Other storefront addresses allowed to call the API, comma-separated
# (CLIENT_URL and its www/bare twin are always allowed).
ALLOWED_ORIGINS=

# ---- Order confirmation email (SMTP) -----------------------------------------
# Leave blank to run in demo mode (the email is logged instead of sent).
# Gmail example: create an "App Password" (Google Account → Security →
#   2-Step Verification → App passwords) and use it as SMTP_PASS.
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "From" address shown on the email (defaults to SMTP_USER)
SHOP_EMAIL=
