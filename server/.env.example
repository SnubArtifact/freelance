# Copy this file to ".env" (same folder) and fill in your values.
# The server loads it automatically on start.

# Admin panel password
ADMIN_PASSWORD=saree-admin

# HDFC SmartGateway — get these from your SmartGateway dashboard.
# Leave HDFC_API_KEY blank to run checkout in demo mode (no real charge).
#   Paste the raw API key; the server Base64-encodes it for you.
HDFC_API_KEY=
HDFC_MERCHANT_ID=
# payment_page_client_id. Defaults to HDFC_MERCHANT_ID in production;
# use "hdfcmaster" for the sandbox.
HDFC_CLIENT_ID=
# "production" (default) or "sandbox"
HDFC_ENV=production
# x-resellerid (leave as default unless the bank tells you otherwise)
HDFC_RESELLER_ID=hdfc_reseller

# Public URLs used for the redirect flow. In production set these to your
# deployed origins (server on Render, storefront on Vercel). The return_url
# HDFC redirects to is PUBLIC_SERVER_URL + /api/payments/hdfc/return.
PUBLIC_SERVER_URL=http://localhost:5050
CLIENT_URL=http://localhost:5173

# Order confirmation email (SMTP). Leave blank to run in demo mode (email is
# logged to the console instead of sent).
# Gmail example: create an "App Password" (Google Account → Security →
#   2-Step Verification → App passwords) and use it as SMTP_PASS.
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "From" address shown on the email (defaults to SMTP_USER)
SHOP_EMAIL=
