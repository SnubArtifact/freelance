# Build-time only — Vite bakes this into the bundle, it is NOT read at runtime.
# Set it in Vercel (Settings → Environment Variables) and then REDEPLOY, or the
# deployed storefront will silently show an empty catalog.
# Leave it unset for local dev; vite.config.js proxies /api to localhost:5050.
VITE_API_BASE=https://api.shophaveliwale.com
